**/out/
**/dist/
**/coverage/
**/.turbo/
**/.vercel/

# ==============================
# Playwright
# ==============================
**/test-results/
**/playwright-report/
**/playwright/.cache/
**/blob-report/

# Keep Playwright configuration and test source files tracked.
# Do not ignore *.spec.ts or *.test.ts globally.

